@model IEnumerable<InvestTrack.Model.Models.Symbol>
@inject InvestTrack.Web.Services.LanguageService Lang
@using Microsoft.AspNetCore.Localization

@{
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture.Name ?? "nl-BE";
    ViewData["Title"] = Lang.Get("Symbols", currentCulture);
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-currency-exchange me-2 text-primary"></i>@Lang.Get("Symbols", currentCulture)</h2>
        
        <!-- Selectieveld op overzicht-view -->
        <div class="d-flex align-items-center gap-2">
            <label for="categoryFilter" class="form-label mb-0 fw-bold"><i class="bi bi-filter me-1"></i>@Lang.Get("Category", currentCulture):</label>
            <select id="categoryFilter" class="form-select bg-dark text-light border-secondary shadow-sm" style="width: 220px;">
                <option value="ALL">-- @Lang.Get("AllCategories", currentCulture) --</option>
                @foreach (var cat in categories)
                {
                    <option value="@cat">@cat</option>
                }
            </select>
        </div>
    </div>

    <div class="card bg-dark border-secondary shadow">
        <div class="card-body p-0">
            <table class="table table-dark table-hover mb-0 align-middle">
                <thead class="table-secondary text-uppercase small">
                    <tr>
                        <th>@Lang.Get("Code", currentCulture)</th>
                        <th>@Lang.Get("Name", currentCulture)</th>
                        <th>@Lang.Get("Category", currentCulture)</th>
                    </tr>
                </thead>
                <tbody id="symbolsTableBody">
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td class="fw-bold text-info">@s.Code</td>
                            <td>@s.DisplayName</td>
                            <td><span class="badge bg-secondary">@s.Category</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('categoryFilter').addEventListener('change', function () {
            var selectedCategory = this.value;
            
            // AJAX verzoek naar /Symbols/FilterJson
            fetch('/Symbols/FilterJson?category=' + encodeURIComponent(selectedCategory))
                .then(response => response.json())
                .then(data => {
                    var tbody = document.getElementById('symbolsTableBody');
                    tbody.innerHTML = '';
                    
                    if (data.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="3" class="text-center text-muted py-3">Geen symbolen gevonden.</td></tr>';
                        return;
                    }
                    
                    data.forEach(s => {
                        var tr = document.createElement('tr');
                        tr.innerHTML = `
                            <td class="fw-bold text-info">${s.code}</td>
                            <td>${s.displayName}</td>
                            <td><span class="badge bg-secondary">${s.category}</span></td>
                        `;
                        tbody.appendChild(tr);
                    });
                })
                .catch(err => console.error('AJAX Error:', err));
        });
    </script>
}
