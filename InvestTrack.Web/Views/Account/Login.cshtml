@model LoginViewModel
@{
    ViewData["Title"] = "Inloggen";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <div class="brand-logo">
                <i class="bi bi-graph-up-arrow"></i>
            </div>
            <h2>InvestTrack</h2>
            <p>Meld u aan bij uw account</p>
        </div>

        <form asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label asp-for="Email" class="form-label">E-mailadres</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                    <input asp-for="Email" class="form-control" placeholder="naam@voorbeeld.nl" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Password" class="form-label">Wachtwoord</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label">Onthoud mij op dit apparaat</label>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 btn-gradient">
                <i class="bi bi-box-arrow-in-right me-2"></i>Inloggen
            </button>
        </form>

        <div class="auth-footer mt-4 text-center">
            <p class="mb-0">Nog geen account? <a asp-action="Register" class="auth-link">Registreer hier</a></p>
        </div>
    </div>
</div>
