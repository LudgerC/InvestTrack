@model RegisterViewModel
@{
    ViewData["Title"] = "Registreren";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <div class="brand-logo">
                <i class="bi bi-person-plus"></i>
            </div>
            <h2>Account Aanmaken</h2>
            <p>Maak een nieuw InvestTrack account aan</p>
        </div>

        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label asp-for="FullName" class="form-label">Volledige Naam</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    <input asp-for="FullName" class="form-control" placeholder="Jan Jansen" />
                </div>
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Email" class="form-label">E-mailadres</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                    <input asp-for="Email" class="form-control" placeholder="naam@voorbeeld.nl" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Password" class="form-label">Wachtwoord</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ConfirmPassword" class="form-label">Bevestig Wachtwoord</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-shield-lock"></i></span>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="••••••••" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 btn-gradient mt-2">
                <i class="bi bi-check-circle me-2"></i>Registreren
            </button>
        </form>

        <div class="auth-footer mt-4 text-center">
            <p class="mb-0">Al een account? <a asp-action="Login" class="auth-link">Log hier in</a></p>
        </div>
    </div>
</div>
