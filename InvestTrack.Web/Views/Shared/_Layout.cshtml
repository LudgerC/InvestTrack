@using InvestTrack.Model.Identity
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Localization
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject InvestTrack.Web.Services.LanguageService Lang

@{
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture.Name ?? "nl";
}

<!DOCTYPE html>
<html lang="@currentCulture" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - InvestTrack</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-dark-subtle text-light d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom border-secondary shadow-sm">
            <div class="container-fluid px-4">
                <a class="navbar-brand d-flex align-items-center fw-bold text-gradient" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-graph-up-arrow me-2 text-primary fs-4"></i>
                    <span>InvestTrack</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> @Lang.Get("Home", currentCulture)
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Symbols" asp-action="Index">
                                <i class="bi bi-currency-exchange me-1"></i> @Lang.Get("Symbols", currentCulture)
                            </a>
                        </li>
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Trader" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i> @Lang.Get("TraderDashboard", currentCulture)
                                </a>
                            </li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="Index">
                                        <i class="bi bi-shield-lock me-1"></i> @Lang.Get("AdminPanel", currentCulture)
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav align-items-center gap-2">
                        <!-- Taalkeuze Dropdown (Selectieveld) -->
                        <li class="nav-item">
                            <form asp-controller="Home" asp-action="SetLanguage" method="post" class="d-flex align-items-center m-0">
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-secondary text-light border-secondary"><i class="bi bi-globe"></i></span>
                                    <select name="culture" class="form-select form-select-sm bg-dark text-light border-secondary" onchange="this.form.submit()">
                                        <!option value="nl-BE" @(currentCulture.StartsWith("nl") ? "selected" : "")>🇧🇪 NL (BE)</!option>
                                        <!option value="fr-BE" @(currentCulture.StartsWith("fr") ? "selected" : "")>🇧🇪 FR (BE)</!option>
                                        <!option value="en-US" @(currentCulture.StartsWith("en") ? "selected" : "")>🇬🇧 EN</!option>
                                    </select>
                                </div>
                            </form>
                        </li>

                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item me-2">
                                <span class="navbar-text text-light small">
                                    <i class="bi bi-person-circle me-1 text-info"></i>
                                    @User.Identity?.Name
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <span class="badge bg-danger ms-1">Admin</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary ms-1">Trader</span>
                                    }
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                        <i class="bi bi-box-arrow-right me-1"></i> @Lang.Get("Logout", currentCulture)
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> @Lang.Get("Login", currentCulture)
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm btn-gradient rounded-pill px-3" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i> @Lang.Get("Register", currentCulture)
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top border-secondary footer bg-dark text-muted py-3 mt-auto">
        <div class="container text-center small">
            &copy; 2026 - InvestTrack Multi-Platform (Model, Desktop, Web, Mobile)
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
