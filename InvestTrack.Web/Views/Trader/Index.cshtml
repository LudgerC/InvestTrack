@model TraderDashboardViewModel
@inject InvestTrack.Web.Services.LanguageService Lang
@using Microsoft.AspNetCore.Localization

@{
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture.Name ?? "nl-BE";
    ViewData["Title"] = Lang.Get("TraderDashboard", currentCulture);
}

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold text-gradient mb-1">@Lang.Get("TraderDashboard", currentCulture)</h1>
            <p class="text-muted small mb-0">InvestTrack Trading & Portfolio Management</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary btn-sm btn-gradient shadow-sm" data-bs-toggle="modal" data-bs-target="#addAccountModal">
                <i class="bi bi-wallet-plus me-1"></i> @Lang.Get("NewAccount", currentCulture)
            </button>
            <button class="btn btn-success btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#addTradeModal">
                <i class="bi bi-plus-circle me-1"></i> @Lang.Get("NewTrade", currentCulture)
            </button>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stat Cards Overview -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card stat-card shadow-sm border-0 bg-dark text-light">
                <div class="card-body d-flex align-items-center">
                    <div class="stat-icon bg-primary bg-opacity-20 text-primary me-3">
                        <i class="bi bi-cash-stack fs-3"></i>
                    </div>
                    <div>
                        <span class="text-muted small text-uppercase font-monospace">@Lang.Get("TotalBalance", currentCulture)</span>
                        <h3 class="mb-0 fw-bold">€ @Model.TotalBalance.ToString("N2")</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card stat-card shadow-sm border-0 bg-dark text-light">
                <div class="card-body d-flex align-items-center">
                    <div class="stat-icon @(Model.TotalProfitLoss >= 0 ? "bg-success" : "bg-danger") bg-opacity-20 @(Model.TotalProfitLoss >= 0 ? "text-success" : "text-danger") me-3">
                        <i class="bi @(Model.TotalProfitLoss >= 0 ? "bi-graph-up-arrow" : "bi-graph-down-arrow") fs-3"></i>
                    </div>
                    <div>
                        <span class="text-muted small text-uppercase font-monospace">@Lang.Get("TotalPL", currentCulture)</span>
                        <h3 class="mb-0 fw-bold @(Model.TotalProfitLoss >= 0 ? "text-success" : "text-danger")">
                            € @Model.TotalProfitLoss.ToString("N2")
                        </h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card stat-card shadow-sm border-0 bg-dark text-light">
                <div class="card-body d-flex align-items-center">
                    <div class="stat-icon bg-warning bg-opacity-20 text-warning me-3">
                        <i class="bi bi-bar-chart-fill fs-3"></i>
                    </div>
                    <div>
                        <span class="text-muted small text-uppercase font-monospace">@Lang.Get("TotalTrades", currentCulture)</span>
                        <h3 class="mb-0 fw-bold">@Model.TotalTradesCount</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <ul class="nav nav-pills custom-tabs mb-4" id="dashboardTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="accounts-tab" data-bs-toggle="pill" data-bs-target="#accounts-pane" type="button" role="tab">
                <i class="bi bi-wallet2 me-2"></i>Accounts (@Model.Accounts.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="trades-tab" data-bs-toggle="pill" data-bs-target="#trades-pane" type="button" role="tab">
                <i class="bi bi-arrow-left-right me-2"></i>Trades (@Model.Trades.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="favorites-tab" data-bs-toggle="pill" data-bs-target="#favorites-pane" type="button" role="tab">
                <i class="bi bi-star-fill me-2"></i>Favorieten (@Model.Favorites.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="symbols-tab" data-bs-toggle="pill" data-bs-target="#symbols-pane" type="button" role="tab">
                <i class="bi bi-currency-exchange me-2"></i>Symbolen (@Model.Symbols.Count)
            </button>
        </li>
    </ul>

    <!-- Tab Contents -->
    <div class="tab-content" id="dashboardTabsContent">
        <!-- 1. ACCOUNTS TAB -->
        <div class="tab-pane fade show active" id="accounts-pane" role="tabpanel">
            <div class="card shadow-sm border-0 bg-dark text-light">
                <div class="card-header bg-dark border-secondary d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 card-title"><i class="bi bi-wallet2 me-2 text-primary"></i>Uw Handelsaccounts</h5>
                    <button class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addAccountModal">
                        <i class="bi bi-plus-lg"></i> Nieuw Account
                    </button>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-dark table-hover mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Accountnaam</th>
                                    <th>Valuta</th>
                                    <th>Saldo</th>
                                    <th class="text-end">Acties</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Accounts.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted">Geen accounts gevonden. Maak eerst een account aan.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var acc in Model.Accounts)
                                    {
                                        <tr>
                                            <td><span class="badge bg-secondary">#@acc.AccountId</span></td>
                                            <td class="fw-bold">@acc.Name</td>
                                            <td><span class="badge bg-info text-dark">@acc.Currency</span></td>
                                            <td class="fw-bold text-success">€ @acc.Balance.ToString("N2")</td>
                                            <td class="text-end">
                                                <button class="btn btn-outline-success btn-sm me-1" data-bs-toggle="modal" data-bs-target="#depositModal" data-account-id="@acc.AccountId" data-account-name="@acc.Name">
                                                    <i class="bi bi-box-arrow-in-down me-1"></i> Storten
                                                </button>
                                                <button class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#withdrawModal" data-account-id="@acc.AccountId" data-account-name="@acc.Name">
                                                    <i class="bi bi-box-arrow-up me-1"></i> Opnemen
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. TRADES TAB -->
        <div class="tab-pane fade" id="trades-pane" role="tabpanel">
            <div class="card shadow-sm border-0 bg-dark text-light">
                <div class="card-header bg-dark border-secondary d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 card-title"><i class="bi bi-arrow-left-right me-2 text-info"></i>Trades Overzicht</h5>
                    <form method="get" class="d-flex align-items-center gap-2">
                        <label class="small text-muted mb-0">Filter Account:</label>
                        <select name="accountId" class="form-select form-select-sm bg-secondary text-light border-0" onchange="this.form.submit()">
                            <option value="0" selected="@(Model.SelectedAccountId == 0)">Alle accounts</option>
                            @foreach (var acc in Model.Accounts)
                            {
                                <option value="@acc.AccountId" selected="@(Model.SelectedAccountId == acc.AccountId)">@acc.Name</option>
                            }
                        </select>
                    </form>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-dark table-hover mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Symbool</th>
                                    <th>Naam</th>
                                    <th>Lots</th>
                                    <th>Winst / Verlies</th>
                                    <th>Account</th>
                                    <th class="text-end">Acties</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Trades.Any())
                                {
                                    <tr>
                                        <td colspan="7" class="text-center py-4 text-muted">Geen trades gevonden voor het geselecteerde filter.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var trade in Model.Trades)
                                    {
                                        <tr>
                                            <td><span class="badge bg-secondary">#@trade.TradeId</span></td>
                                            <td><span class="badge bg-primary">@trade.SymbolCode</span></td>
                                            <td>@trade.SymbolName</td>
                                            <td>@trade.Lots.ToString("N2")</td>
                                            <td class="fw-bold @(trade.ProfitLoss >= 0 ? "text-success" : "text-danger")">
                                                € @trade.ProfitLoss.ToString("N2")
                                            </td>
                                            <td>@trade.AccountName</td>
                                            <td class="text-end">
                                                <form asp-action="ToggleFavorite" method="post" class="d-inline">
                                                    <input type="hidden" name="tradeId" value="@trade.TradeId" />
                                                    <button type="submit" class="btn btn-link btn-sm p-0 me-2 text-decoration-none">
                                                        <i class="bi @(trade.IsFavorite ? "bi-star-fill text-warning" : "bi-star text-muted") fs-5"></i>
                                                    </button>
                                                </form>
                                                <form asp-action="DeleteTrade" method="post" class="d-inline" onsubmit="return confirm('Weet u zeker dat u deze trade wilt verwijderen?');">
                                                    <input type="hidden" name="tradeId" value="@trade.TradeId" />
                                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. FAVORITES TAB -->
        <div class="tab-pane fade" id="favorites-pane" role="tabpanel">
            <div class="card shadow-sm border-0 bg-dark text-light">
                <div class="card-header bg-dark border-secondary d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 card-title"><i class="bi bi-star-fill me-2 text-warning"></i>Gemarkeerde Favoriete Trades</h5>
                    <form method="get" class="d-flex align-items-center gap-2">
                        <label class="small text-muted mb-0">Filter Account:</label>
                        <select name="favAccountId" class="form-select form-select-sm bg-secondary text-light border-0" onchange="this.form.submit()">
                            <option value="0" selected="@(Model.SelectedFavoritesAccountId == 0)">Alle accounts</option>
                            @foreach (var acc in Model.Accounts)
                            {
                                <option value="@acc.AccountId" selected="@(Model.SelectedFavoritesAccountId == acc.AccountId)">@acc.Name</option>
                            }
                        </select>
                    </form>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-dark table-hover mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Symbool</th>
                                    <th>Naam</th>
                                    <th>Lots</th>
                                    <th>Winst / Verlies</th>
                                    <th>Account</th>
                                    <th class="text-end">Actie</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Favorites.Any())
                                {
                                    <tr>
                                        <td colspan="7" class="text-center py-4 text-muted">Nog geen favorieten gemarkeerd. Klik op de ster bij een trade om te markeren.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var fav in Model.Favorites)
                                    {
                                        <tr>
                                            <td><span class="badge bg-secondary">#@fav.TradeId</span></td>
                                            <td><span class="badge bg-warning text-dark">@fav.SymbolCode</span></td>
                                            <td>@fav.SymbolName</td>
                                            <td>@fav.Lots.ToString("N2")</td>
                                            <td class="fw-bold @(fav.ProfitLoss >= 0 ? "text-success" : "text-danger")">
                                                € @fav.ProfitLoss.ToString("N2")
                                            </td>
                                            <td>@fav.AccountName</td>
                                            <td class="text-end">
                                                <form asp-action="ToggleFavorite" method="post" class="d-inline">
                                                    <input type="hidden" name="tradeId" value="@fav.TradeId" />
                                                    <button type="submit" class="btn btn-outline-warning btn-sm">
                                                        <i class="bi bi-star-fill me-1"></i> Verwijder uit favorieten
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. SYMBOLS TAB -->
        <div class="tab-pane fade" id="symbols-pane" role="tabpanel">
            <div class="card shadow-sm border-0 bg-dark text-light">
                <div class="card-header bg-dark border-secondary d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 card-title"><i class="bi bi-currency-exchange me-2 text-success"></i>Beschikbare Symbolen</h5>
                    <form method="get" class="d-flex align-items-center gap-2">
                        <label class="small text-muted mb-0">Categorie:</label>
                        <select name="category" class="form-select form-select-sm bg-secondary text-light border-0" onchange="this.form.submit()">
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat" selected="@(Model.SelectedCategory == cat)">@cat</option>
                            }
                        </select>
                    </form>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-dark table-hover mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Code</th>
                                    <th>Naam</th>
                                    <th>Categorie</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sym in Model.Symbols)
                                {
                                    <tr>
                                        <td><span class="badge bg-secondary">#@sym.Id</span></td>
                                        <td class="fw-bold"><span class="badge bg-info text-dark">@sym.Code</span></td>
                                        <td>@sym.DisplayName</td>
                                        <td><span class="badge bg-secondary">@sym.Category</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= MODALS ================= -->

<!-- Add Account Modal -->
<div class="modal fade" id="addAccountModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-light border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title"><i class="bi bi-wallet-plus me-2 text-primary"></i>Nieuw Account Toevoegen</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddAccount" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Accountnaam</label>
                        <input type="text" name="name" class="form-control bg-secondary text-light border-0" placeholder="bv. Hoofd Trading Account" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Valuta</label>
                        <select name="currency" class="form-select bg-secondary text-light border-0">
                            <option value="EUR">EUR (€)</option>
                            <option value="USD">USD ($)</option>
                            <option value="GBP">GBP (£)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Startsaldo (€)</label>
                        <input type="number" step="0.01" name="initialBalance" class="form-control bg-secondary text-light border-0" value="1000.00" required />
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuleren</button>
                    <button type="submit" class="btn btn-primary btn-gradient">Account Opslaan</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Add Trade Modal -->
<div class="modal fade" id="addTradeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-light border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title"><i class="bi bi-plus-circle me-2 text-success"></i>Nieuwe Trade Toevoegen</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddTrade" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Account</label>
                        <select name="accountId" class="form-select bg-secondary text-light border-0" required>
                            @foreach (var acc in Model.Accounts)
                            {
                                <option value="@acc.AccountId">@acc.Name (€@acc.Balance.ToString("N2"))</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Symbool</label>
                        <select name="symbolId" class="form-select bg-secondary text-light border-0" required>
                            @foreach (var sym in Model.Symbols)
                            {
                                <option value="@sym.Id">@sym.Code - @sym.DisplayName (@sym.Category)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Aantal Lots</label>
                        <input type="number" step="0.01" name="lots" class="form-control bg-secondary text-light border-0" value="1.00" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Winst / Verlies (€)</label>
                        <input type="number" step="0.01" name="profitLoss" class="form-control bg-secondary text-light border-0" value="50.00" required />
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuleren</button>
                    <button type="submit" class="btn btn-success">Trade Opslaan</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Deposit Modal -->
<div class="modal fade" id="depositModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-light border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title"><i class="bi bi-box-arrow-in-down me-2 text-success"></i>Geld Storten (Deposit)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="depositForm">
                <input type="hidden" name="accountId" id="depositAccountId" />
                <div class="modal-body">
                    <p class="text-muted small">Account: <strong id="depositAccountName" class="text-light"></strong></p>
                    <div class="mb-3">
                        <label class="form-label">Stortingsbedrag (€)</label>
                        <input type="number" step="0.01" name="amount" id="depositAmount" class="form-control bg-secondary text-light border-0" placeholder="100.00" required />
                    </div>
                    <div id="depositAlert" class="alert alert-info d-none py-2 small"></div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuleren</button>
                    <button type="submit" class="btn btn-success"><i class="bi bi-box-arrow-in-down me-1"></i> Storten (via AJAX)</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Withdraw Modal -->
<div class="modal fade" id="withdrawModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-light border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title"><i class="bi bi-box-arrow-up me-2 text-danger"></i>Geld Opnemen (Withdrawal)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="withdrawForm">
                <input type="hidden" name="accountId" id="withdrawAccountId" />
                <div class="modal-body">
                    <p class="text-muted small">Account: <strong id="withdrawAccountName" class="text-light"></strong></p>
                    <div class="mb-3">
                        <label class="form-label">Opnamebedrag (€)</label>
                        <input type="number" step="0.01" name="amount" id="withdrawAmount" class="form-control bg-secondary text-light border-0" placeholder="50.00" required />
                    </div>
                    <div id="withdrawAlert" class="alert alert-info d-none py-2 small"></div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuleren</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-box-arrow-up me-1"></i> Opnemen (via AJAX)</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var depositModal = document.getElementById('depositModal');
            if (depositModal) {
                depositModal.addEventListener('show.bs.modal', function (event) {
                    var button = event.relatedTarget;
                    document.getElementById('depositAccountId').value = button.getAttribute('data-account-id');
                    document.getElementById('depositAccountName').textContent = button.getAttribute('data-account-name');
                    document.getElementById('depositAlert').classList.add('d-none');
                });
            }

            var withdrawModal = document.getElementById('withdrawModal');
            if (withdrawModal) {
                withdrawModal.addEventListener('show.bs.modal', function (event) {
                    var button = event.relatedTarget;
                    document.getElementById('withdrawAccountId').value = button.getAttribute('data-account-id');
                    document.getElementById('withdrawAccountName').textContent = button.getAttribute('data-account-name');
                    document.getElementById('withdrawAlert').classList.add('d-none');
                });
            }

            // AJAX Submit for Deposit Form
            document.getElementById('depositForm').addEventListener('submit', function (e) {
                e.preventDefault();
                var accountId = document.getElementById('depositAccountId').value;
                var amount = document.getElementById('depositAmount').value;
                var alertBox = document.getElementById('depositAlert');

                var formData = new FormData();
                formData.append('accountId', accountId);
                formData.append('amount', amount);

                fetch('/Trader/DepositAjax', {
                    method: 'POST',
                    body: formData
                })
                .then(r => r.json())
                .then(data => {
                    alertBox.classList.remove('d-none', 'alert-danger', 'alert-success');
                    if (data.success) {
                        alertBox.classList.add('alert-success');
                        alertBox.textContent = data.message;
                        setTimeout(() => {
                            location.reload();
                        }, 1000);
                    } else {
                        alertBox.classList.add('alert-danger');
                        alertBox.textContent = data.message;
                    }
                })
                .catch(err => console.error('AJAX Deposit Error:', err));
            });

            // AJAX Submit for Withdraw Form
            document.getElementById('withdrawForm').addEventListener('submit', function (e) {
                e.preventDefault();
                var accountId = document.getElementById('withdrawAccountId').value;
                var amount = document.getElementById('withdrawAmount').value;
                var alertBox = document.getElementById('withdrawAlert');

                var formData = new FormData();
                formData.append('accountId', accountId);
                formData.append('amount', amount);

                fetch('/Trader/WithdrawAjax', {
                    method: 'POST',
                    body: formData
                })
                .then(r => r.json())
                .then(data => {
                    alertBox.classList.remove('d-none', 'alert-danger', 'alert-success');
                    if (data.success) {
                        alertBox.classList.add('alert-success');
                        alertBox.textContent = data.message;
                        setTimeout(() => {
                            location.reload();
                        }, 1000);
                    } else {
                        alertBox.classList.add('alert-danger');
                        alertBox.textContent = data.message;
                    }
                })
                .catch(err => console.error('AJAX Withdraw Error:', err));
            });
        });
    </script>
}
